# Copy this file to .env and fill in the values you need.

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_RESPONSE_CACHE=true
OPENROUTER_PROMPT_CACHE=true
OPENROUTER_RESPONSE_CACHE_TTL=300
OPENROUTER_PROMPT_CACHE_TTL=1h
OPENROUTER_SESSION_ID=milky

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Application
AI_TIMEOUT=120
AI_HISTORY_LIMIT=20
SETTINGS_FILE=settings.json
MEMORY_FILE=memory.json
HISTORY_FILE=history.json
OUTFIT_FILE=outfit.json

# Text to speech (Milky TTS server)
TTS_ENABLED=true
TTS_PROVIDER=milka
MILKY_TTS_URL=http://192.168.1.100:8765
MILKY_TTS_VOICE=sveta
MILKY_TTS_SPEED=1.0
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
