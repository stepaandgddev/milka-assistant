# Copy this file to .env and fill in the values you need.

# Ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_RESPONSE_CACHE=true
OPENROUTER_PROMPT_CACHE=true
OPENROUTER_RESPONSE_CACHE_TTL=300
OPENROUTER_PROMPT_CACHE_TTL=1h
OPENROUTER_SESSION_ID=milky

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Screen vision (optional): use any multimodal model. Groq qwen/qwen3.8-27b
# works, but if it returns empty or wrong descriptions, switch to a stronger
# vision model (for example Baseten DeepSeek V4.1 Flash, Gemini, GPT-4o-mini,
# or a local Ollama qwen3-vl:8b). Text-only models cannot see screenshots.
VISION_ENABLED=true
VISION_PROVIDER=Groq
VISION_MODEL=qwen/qwen3.8-27b
VISION_MAX_WIDTH=1600
VISION_JPEG_QUALITY=82

# Web search and conversation compaction (built in)
SEARCH_ENABLED=true
SEARCH_MAX_RESULTS=5
SEARCH_REGION=ru-ru
SEARCH_SAFESEARCH=moderate
SEARCH_TIMEOUT=6
SEARCH_PAGE_TIMEOUT=8
SEARCH_GOOGLE=true
SEARCH_YOUTUBE=true

# Drawings (optional): Cloudflare Workers AI with FLUX.1 schnell
# Leave DRAWING_PROVIDER unset to use Cloudflare automatically when both
# credentials are present. Set it to "model" to keep the SVG drawing path.
# DRAWING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_IMAGE_TIMEOUT=120

# Life cycle (optional): let Milky suggest an outfit or draw something on her
# own between conversations. Set LIFE_ENABLED=false to turn it off entirely.
LIFE_ENABLED=true
LIFE_SUGGEST_OUTFIT=true
LIFE_DRAW=true
LIFE_MIN_MINUTES=10
LIFE_MAX_MINUTES=30

# Application
AI_TIMEOUT=120
AI_HISTORY_LIMIT=20
HISTORY_KEEP_RECENT=6
SETTINGS_FILE=settings.json
MEMORY_FILE=memory.json
HISTORY_FILE=history.json
OUTFIT_FILE=outfit.json

# Text to speech (Milky TTS server)
TTS_ENABLED=true
TTS_PROVIDER=milka
MILKY_TTS_URL=http://192.168.1.100:8765
MILKY_TTS_VOICE=sveta
MILKY_TTS_SPEED=1.0
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=hannah
